        <di:waypoint x="780" y="655" />
        <di:waypoint x="730" y="655" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow9_di" bpmnElement="Flow9">
        <di:waypoint x="490" y="655" />
        <di:waypoint x="440" y="655" />
