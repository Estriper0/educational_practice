<?xml version='1.0' encoding='utf-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns2="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns4="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions" targetNamespace="https://example.org/cable-acceptance">
  <ns0:process id="Process" name="Регистрация испытаний партии кабеля и решение о приёмке" isExecutable="false">
    <ns0:laneSet id="LaneSet">
      <ns0:lane id="master" name="Мастер производства">
        <ns0:flowNodeRef>start</ns0:flowNodeRef>
        <ns0:flowNodeRef>submit</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="otk" name="Контролёр ОТК">
        <ns0:flowNodeRef>check</ns0:flowNodeRef>
        <ns0:flowNodeRef>docs</ns0:flowNodeRef>
        <ns0:flowNodeRef>wait</ns0:flowNodeRef>
        <ns0:flowNodeRef>hold</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="lab" name="Лаборант">
        <ns0:flowNodeRef>sample</ns0:flowNodeRef>
        <ns0:flowNodeRef>measure</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="system" name="Информационная система">
        <ns0:flowNodeRef>validate</ns0:flowNodeRef>
        <ns0:flowNodeRef>evaluate</ns0:flowNodeRef>
        <ns0:flowNodeRef>make</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="head" name="Уполномоченный ОТК">
        <ns0:flowNodeRef>review</ns0:flowNodeRef>
        <ns0:flowNodeRef>approve</ns0:flowNodeRef>
        <ns0:flowNodeRef>fix</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="store" name="Склад и производство">
        <ns0:flowNodeRef>send</ns0:flowNodeRef>
        <ns0:flowNodeRef>end</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>
    <ns0:startEvent id="start" name="Партия готова">
      <ns0:outgoing>Flow0</ns0:outgoing>
    </ns0:startEvent>
    <ns0:userTask id="submit" name="Передать партию и документы">
      <ns0:incoming>Flow0</ns0:incoming>
      <ns0:outgoing>Flow1</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="check" name="Проверить документы и план">
      <ns0:incoming>Flow1</ns0:incoming>
      <ns0:outgoing>Flow2</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="docs" name="Документы полны?">
      <ns0:incoming>Flow2</ns0:incoming>
      <ns0:outgoing>Flow3</ns0:outgoing>
      <ns0:outgoing>Flow5</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="wait" name="Запросить уточнение">
      <ns0:incoming>Flow3</ns0:incoming>
      <ns0:outgoing>Flow4</ns0:outgoing>
    </ns0:userTask>
    <ns0:endEvent id="hold" name="Ожидание уточнения">
      <ns0:incoming>Flow4</ns0:incoming>
    </ns0:endEvent>
    <ns0:userTask id="sample" name="Зарегистрировать образцы">
      <ns0:incoming>Flow5</ns0:incoming>
      <ns0:outgoing>Flow6</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="measure" name="Выполнить испытания и ввести результаты">
      <ns0:incoming>Flow6</ns0:incoming>
      <ns0:outgoing>Flow7</ns0:outgoing>
      <ns0:incoming>Flow13</ns0:incoming>
    </ns0:userTask>
    <ns0:serviceTask id="validate" name="Проверить формат результатов">
      <ns0:incoming>Flow7</ns0:incoming>
      <ns0:outgoing>Flow8</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="evaluate" name="Сопоставить результаты с планом">
      <ns0:incoming>Flow8</ns0:incoming>
      <ns0:outgoing>Flow9</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="make" name="Сформировать проект протокола">
      <ns0:incoming>Flow9</ns0:incoming>
      <ns0:outgoing>Flow10</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:userTask id="review" name="Проверить проект протокола">
      <ns0:incoming>Flow10</ns0:incoming>
      <ns0:outgoing>Flow11</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="approve" name="Решение утверждено?">
      <ns0:incoming>Flow11</ns0:incoming>
      <ns0:outgoing>Flow12</ns0:outgoing>
      <ns0:outgoing>Flow14</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="fix" name="Вернуть на уточнение">
      <ns0:incoming>Flow12</ns0:incoming>
      <ns0:outgoing>Flow13</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="send" name="Передать протокол и статус">
      <ns0:incoming>Flow14</ns0:incoming>
      <ns0:outgoing>Flow15</ns0:outgoing>
    </ns0:userTask>
    <ns0:endEvent id="end" name="Результат передан">
      <ns0:incoming>Flow15</ns0:incoming>
    </ns0:endEvent>
    <ns0:sequenceFlow id="Flow0" sourceRef="start" targetRef="submit" name="" />
    <ns0:sequenceFlow id="Flow1" sourceRef="submit" targetRef="check" name="" />
    <ns0:sequenceFlow id="Flow2" sourceRef="check" targetRef="docs" name="" />
    <ns0:sequenceFlow id="Flow3" sourceRef="docs" targetRef="wait" name="Нет">
      <ns0:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow4" sourceRef="wait" targetRef="hold" name="" />
    <ns0:sequenceFlow id="Flow5" sourceRef="docs" targetRef="sample" name="Да">
      <ns0:conditionExpression xsi:type="bpmn:tFormalExpression">Да</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow6" sourceRef="sample" targetRef="measure" name="" />
    <ns0:sequenceFlow id="Flow7" sourceRef="measure" targetRef="validate" name="" />
    <ns0:sequenceFlow id="Flow8" sourceRef="validate" targetRef="evaluate" name="" />
    <ns0:sequenceFlow id="Flow9" sourceRef="evaluate" targetRef="make" name="" />
    <ns0:sequenceFlow id="Flow10" sourceRef="make" targetRef="review" name="" />
    <ns0:sequenceFlow id="Flow11" sourceRef="review" targetRef="approve" name="" />
    <ns0:sequenceFlow id="Flow12" sourceRef="approve" targetRef="fix" name="Нет">
      <ns0:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow13" sourceRef="fix" targetRef="measure" name="" />
    <ns0:sequenceFlow id="Flow14" sourceRef="approve" targetRef="send" name="Да">
      <ns0:conditionExpression xsi:type="bpmn:tFormalExpression">Да</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow15" sourceRef="send" targetRef="end" name="" />
    <ns0:dataObject id="objects1Data" name="Изделие; партия; версия плана; правила; виды проверок" />
    <ns0:dataObjectReference id="objects1" name="Изделие; партия; версия плана; правила; виды проверок" dataObjectRef="objects1Data" />
    <ns0:dataObject id="objects2Data" name="Образцы; сотрудники; измерения" />
    <ns0:dataObjectReference id="objects2" name="Образцы; сотрудники; измерения" dataObjectRef="objects2Data" />
    <ns0:dataObject id="objects3Data" name="Протокол и решение ОТК" />
    <ns0:dataObjectReference id="objects3" name="Протокол и решение ОТК" dataObjectRef="objects3Data" />
    <ns0:association id="Assoc0" sourceRef="objects1" targetRef="check" associationDirection="One" />
    <ns0:association id="Assoc1" sourceRef="measure" targetRef="objects2" associationDirection="One" />
    <ns0:association id="Assoc2" sourceRef="review" targetRef="objects3" associationDirection="One" />
  </ns0:process>
  <ns0:collaboration id="Collaboration">
    <ns0:participant id="Pool" name="Предприятие кабельного производства" processRef="Process" />
  </ns0:collaboration>
  <ns2:BPMNDiagram id="Diagram">
    <ns2:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <ns2:BPMNShape id="Pool_di" bpmnElement="Pool" isHorizontal="true">
        <ns3:Bounds x="10" y="55" width="1540" height="1060" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="master_di" bpmnElement="master" isHorizontal="true">
        <ns3:Bounds x="40" y="55" width="1510" height="150" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="otk_di" bpmnElement="otk" isHorizontal="true">
        <ns3:Bounds x="40" y="205" width="1510" height="190" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="lab_di" bpmnElement="lab" isHorizontal="true">
        <ns3:Bounds x="40" y="395" width="1510" height="170" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="system_di" bpmnElement="system" isHorizontal="true">
        <ns3:Bounds x="40" y="565" width="1510" height="230" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="head_di" bpmnElement="head" isHorizontal="true">
        <ns3:Bounds x="40" y="795" width="1510" height="170" />
