      </ns2:BPMNShape>
      <ns2:BPMNShape id="check_di" bpmnElement="check">
        <ns3:Bounds x="500" y="260" width="210" height="70" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="docs_di" bpmnElement="docs">
        <ns3:Bounds x="770" y="245" width="160" height="100" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="wait_di" bpmnElement="wait">
        <ns3:Bounds x="1030" y="260" width="190" height="70" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="hold_di" bpmnElement="hold">
        <ns3:Bounds x="1330" y="270" width="55" height="55" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="sample_di" bpmnElement="sample">
        <ns3:Bounds x="500" y="440" width="210" height="70" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="measure_di" bpmnElement="measure">
        <ns3:Bounds x="780" y="440" width="230" height="70" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="validate_di" bpmnElement="validate">
        <ns3:Bounds x="780" y="620" width="230" height="70" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="evaluate_di" bpmnElement="evaluate">
        <ns3:Bounds x="490" y="620" width="240" height="70" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="make_di" bpmnElement="make">
        <ns3:Bounds x="200" y="620" width="240" height="70" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="review_di" bpmnElement="review">
        <ns3:Bounds x="200" y="840" width="240" height="70" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="approve_di" bpmnElement="approve">
        <ns3:Bounds x="520" y="825" width="170" height="100" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="fix_di" bpmnElement="fix">
        <ns3:Bounds x="820" y="845" width="190" height="70" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="send_di" bpmnElement="send">
        <ns3:Bounds x="200" y="1000" width="240" height="70" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="end_di" bpmnElement="end">
        <ns3:Bounds x="570" y="1005" width="55" height="55" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="objects1_di" bpmnElement="objects1">
        <ns3:Bounds x="85" y="345" width="350" height="48" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="objects2_di" bpmnElement="objects2">
        <ns3:Bounds x="1050" y="530" width="400" height="30" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="objects3_di" bpmnElement="objects3">
        <ns3:Bounds x="1050" y="925" width="370" height="30" />
      </ns2:BPMNShape>
      <ns2:BPMNEdge id="Flow0_di" bpmnElement="Flow0">
        <ns4:waypoint x="175" y="137.5" />
        <ns4:waypoint x="260" y="140.0" />
      </ns2:BPMNEdge>
      <ns2:BPMNEdge id="Flow1_di" bpmnElement="Flow1">
        <ns4:waypoint x="460" y="140" />
        <ns4:waypoint x="605" y="140" />
        <ns4:waypoint x="605" y="260" />
      </ns2:BPMNEdge>
      <ns2:BPMNEdge id="Flow2_di" bpmnElement="Flow2">
        <ns4:waypoint x="710" y="295.0" />
        <ns4:waypoint x="770" y="295.0" />
      </ns2:BPMNEdge>
