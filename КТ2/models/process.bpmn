<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions" targetNamespace="https://example.org/cable-acceptance">
  <bpmn:process id="Process" name="Регистрация испытаний партии кабеля и решение о приёмке" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="master" name="Мастер производства">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="otk" name="Контролёр ОТК">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hold</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lab" name="Лаборант">
        <bpmn:flowNodeRef>sample</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>measure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Информационная система">
        <bpmn:flowNodeRef>validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>make</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="head" name="Уполномоченный ОТК">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="store" name="Склад и производство">
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Партия готова">
      <bpmn:outgoing>Flow0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="submit" name="Передать партию и документы">
      <bpmn:incoming>Flow0</bpmn:incoming>
      <bpmn:outgoing>Flow1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="check" name="Проверить документы и план">
      <bpmn:incoming>Flow1</bpmn:incoming>
      <bpmn:outgoing>Flow2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="docs" name="Документы полны?">
      <bpmn:incoming>Flow2</bpmn:incoming>
      <bpmn:outgoing>Flow3</bpmn:outgoing>
      <bpmn:outgoing>Flow5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="wait" name="Запросить уточнение">
      <bpmn:incoming>Flow3</bpmn:incoming>
      <bpmn:outgoing>Flow4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="hold" name="Ожидание уточнения">
      <bpmn:incoming>Flow4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="sample" name="Зарегистрировать образцы">
      <bpmn:incoming>Flow5</bpmn:incoming>
      <bpmn:outgoing>Flow6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="measure" name="Выполнить испытания и ввести результаты">
      <bpmn:incoming>Flow6</bpmn:incoming>
      <bpmn:outgoing>Flow7</bpmn:outgoing>
      <bpmn:incoming>Flow13</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:serviceTask id="validate" name="Проверить формат результатов">
      <bpmn:incoming>Flow7</bpmn:incoming>
      <bpmn:outgoing>Flow8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="evaluate" name="Сопоставить результаты с планом">
      <bpmn:incoming>Flow8</bpmn:incoming>
      <bpmn:outgoing>Flow9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="make" name="Сформировать проект протокола">
      <bpmn:incoming>Flow9</bpmn:incoming>
      <bpmn:outgoing>Flow10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="review" name="Проверить проект протокола">
      <bpmn:incoming>Flow10</bpmn:incoming>
      <bpmn:outgoing>Flow11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="approve" name="Решение утверждено?">
      <bpmn:incoming>Flow11</bpmn:incoming>
      <bpmn:outgoing>Flow12</bpmn:outgoing>
      <bpmn:outgoing>Flow14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="fix" name="Вернуть на уточнение">
      <bpmn:incoming>Flow12</bpmn:incoming>
      <bpmn:outgoing>Flow13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="send" name="Передать протокол и статус">
      <bpmn:incoming>Flow14</bpmn:incoming>
      <bpmn:outgoing>Flow15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end" name="Результат передан">
      <bpmn:incoming>Flow15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow0" sourceRef="start" targetRef="submit" name="" />
    <bpmn:sequenceFlow id="Flow1" sourceRef="submit" targetRef="check" name="" />
    <bpmn:sequenceFlow id="Flow2" sourceRef="check" targetRef="docs" name="" />
    <bpmn:sequenceFlow id="Flow3" sourceRef="docs" targetRef="wait" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow4" sourceRef="wait" targetRef="hold" name="" />
    <bpmn:sequenceFlow id="Flow5" sourceRef="docs" targetRef="sample" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow6" sourceRef="sample" targetRef="measure" name="" />
    <bpmn:sequenceFlow id="Flow7" sourceRef="measure" targetRef="validate" name="" />
    <bpmn:sequenceFlow id="Flow8" sourceRef="validate" targetRef="evaluate" name="" />
    <bpmn:sequenceFlow id="Flow9" sourceRef="evaluate" targetRef="make" name="" />
    <bpmn:sequenceFlow id="Flow10" sourceRef="make" targetRef="review" name="" />
    <bpmn:sequenceFlow id="Flow11" sourceRef="review" targetRef="approve" name="" />
    <bpmn:sequenceFlow id="Flow12" sourceRef="approve" targetRef="fix" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow13" sourceRef="fix" targetRef="measure" name="" />
    <bpmn:sequenceFlow id="Flow14" sourceRef="approve" targetRef="send" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow15" sourceRef="send" targetRef="end" name="" />
    <bpmn:dataObject id="objects1Data" name="Изделие; партия; версия плана; правила; виды проверок" />
    <bpmn:dataObjectReference id="objects1" name="Изделие; партия; версия плана; правила; виды проверок" dataObjectRef="objects1Data" />
    <bpmn:dataObject id="objects2Data" name="Образцы; сотрудники; измерения" />
    <bpmn:dataObjectReference id="objects2" name="Образцы; сотрудники; измерения" dataObjectRef="objects2Data" />
    <bpmn:dataObject id="objects3Data" name="Протокол и решение ОТК" />
    <bpmn:dataObjectReference id="objects3" name="Протокол и решение ОТК" dataObjectRef="objects3Data" />
    <bpmn:association id="Assoc0" sourceRef="objects1" targetRef="check" associationDirection="One" />
    <bpmn:association id="Assoc1" sourceRef="measure" targetRef="objects2" associationDirection="One" />
    <bpmn:association id="Assoc2" sourceRef="review" targetRef="objects3" associationDirection="One" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Pool" name="Предприятие кабельного производства" processRef="Process" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="Pool_di" bpmnElement="Pool" isHorizontal="true">
        <dc:Bounds x="10" y="55" width="1540" height="1060" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="master_di" bpmnElement="master" isHorizontal="true">
        <dc:Bounds x="40" y="55" width="1510" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="otk_di" bpmnElement="otk" isHorizontal="true">
        <dc:Bounds x="40" y="205" width="1510" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lab_di" bpmnElement="lab" isHorizontal="true">
        <dc:Bounds x="40" y="395" width="1510" height="170" />
