      <ns2:BPMNShape id="store_di" bpmnElement="store" isHorizontal="true">
        <ns3:Bounds x="40" y="965" width="1510" height="150" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="start_di" bpmnElement="start">
        <ns3:Bounds x="120" y="110" width="55" height="55" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="submit_di" bpmnElement="submit">
