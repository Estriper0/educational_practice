      </ns2:BPMNEdge>
      <ns2:BPMNEdge id="Assoc0_di" bpmnElement="Assoc0">
        <ns4:waypoint x="435" y="369" /><ns4:waypoint x="450" y="369" /><ns4:waypoint x="450" y="330" /><ns4:waypoint x="500" y="300" /></ns2:BPMNEdge>
      <ns2:BPMNEdge id="Assoc1_di" bpmnElement="Assoc1">
        <ns4:waypoint x="1010" y="490" /><ns4:waypoint x="1030" y="490" /><ns4:waypoint x="1030" y="545" /><ns4:waypoint x="1050" y="545" /></ns2:BPMNEdge>
      <ns2:BPMNEdge id="Assoc2_di" bpmnElement="Assoc2">
