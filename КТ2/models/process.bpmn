      <bpmndi:BPMNShape id="system_di" bpmnElement="system" isHorizontal="true">
        <dc:Bounds x="40" y="565" width="1510" height="230" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="head_di" bpmnElement="head" isHorizontal="true">
        <dc:Bounds x="40" y="795" width="1510" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="store_di" bpmnElement="store" isHorizontal="true">
        <dc:Bounds x="40" y="965" width="1510" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="120" y="110" width="55" height="55" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="submit_di" bpmnElement="submit">
        <dc:Bounds x="260" y="105" width="200" height="70" />
      </bpmndi:BPMNShape>
