      <bpmndi:BPMNShape id="docs_di" bpmnElement="docs">
        <dc:Bounds x="770" y="245" width="160" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait_di" bpmnElement="wait">
