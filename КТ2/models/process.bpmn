        <ns4:waypoint x="1220" y="295.0" />
        <ns4:waypoint x="1330" y="297.5" />
      </ns2:BPMNEdge>
      <ns2:BPMNEdge id="Flow5_di" bpmnElement="Flow5">
        <ns4:waypoint x="850" y="345" />
        <ns4:waypoint x="850" y="370" />
        <ns4:waypoint x="605" y="370" />
        <ns4:waypoint x="605" y="440" />
      </ns2:BPMNEdge>
      <ns2:BPMNEdge id="Flow6_di" bpmnElement="Flow6">
        <ns4:waypoint x="710" y="475.0" />
        <ns4:waypoint x="780" y="475.0" />
      </ns2:BPMNEdge>
      <ns2:BPMNEdge id="Flow7_di" bpmnElement="Flow7">
        <ns4:waypoint x="895" y="510" />
        <ns4:waypoint x="895" y="620" />
      </ns2:BPMNEdge>
      <ns2:BPMNEdge id="Flow8_di" bpmnElement="Flow8">
        <ns4:waypoint x="780" y="655" />
        <ns4:waypoint x="730" y="655" />
      </ns2:BPMNEdge>
      <ns2:BPMNEdge id="Flow9_di" bpmnElement="Flow9">
        <ns4:waypoint x="490" y="655" />
        <ns4:waypoint x="440" y="655" />
      </ns2:BPMNEdge>
      <ns2:BPMNEdge id="Flow10_di" bpmnElement="Flow10">
        <ns4:waypoint x="320" y="690" />
        <ns4:waypoint x="320" y="840" />
      </ns2:BPMNEdge>
      <ns2:BPMNEdge id="Flow11_di" bpmnElement="Flow11">
        <ns4:waypoint x="440" y="875.0" />
        <ns4:waypoint x="520" y="875.0" />
      </ns2:BPMNEdge>
      <ns2:BPMNEdge id="Flow12_di" bpmnElement="Flow12">
        <ns4:waypoint x="690" y="875.0" />
