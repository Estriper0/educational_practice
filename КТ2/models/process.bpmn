      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="hold_di" bpmnElement="hold">
        <dc:Bounds x="1330" y="270" width="55" height="55" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sample_di" bpmnElement="sample">
        <dc:Bounds x="500" y="440" width="210" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="measure_di" bpmnElement="measure">
        <dc:Bounds x="780" y="440" width="230" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="validate_di" bpmnElement="validate">
        <dc:Bounds x="780" y="620" width="230" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evaluate_di" bpmnElement="evaluate">
        <dc:Bounds x="490" y="620" width="240" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="make_di" bpmnElement="make">
        <dc:Bounds x="200" y="620" width="240" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="review_di" bpmnElement="review">
        <dc:Bounds x="200" y="840" width="240" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approve_di" bpmnElement="approve">
        <dc:Bounds x="520" y="825" width="170" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fix_di" bpmnElement="fix">
        <dc:Bounds x="820" y="845" width="190" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="send_di" bpmnElement="send">
        <dc:Bounds x="200" y="1000" width="240" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="570" y="1005" width="55" height="55" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="objects1_di" bpmnElement="objects1">
        <dc:Bounds x="350" y="345" width="400" height="35" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="objects2_di" bpmnElement="objects2">
        <dc:Bounds x="1030" y="490" width="400" height="35" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="objects3_di" bpmnElement="objects3">
        <dc:Bounds x="1030" y="910" width="400" height="35" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow0_di" bpmnElement="Flow0">
        <di:waypoint x="175" y="137.5" />
        <di:waypoint x="260" y="140.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow1_di" bpmnElement="Flow1">
        <di:waypoint x="460" y="140" />
        <di:waypoint x="605" y="140" />
        <di:waypoint x="605" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow2_di" bpmnElement="Flow2">
        <di:waypoint x="710" y="295.0" />
        <di:waypoint x="770" y="295.0" />
      </bpmndi:BPMNEdge>
